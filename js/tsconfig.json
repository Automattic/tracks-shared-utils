{
	"compilerOptions": {
		"target": "ES2019",
		"lib": [ "ES2019" ],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"resolveJsonModule": true,
		"allowJs": true,
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": [ "src", "test", "scripts", "tsup.config.ts" ]
}
