		"expected": "https://wordpress.com/?tab=a"
	},
	{
		"description": "drops a value whose ? is encoded more than once behind a decode failure",
		"input": "https://wordpress.com/?query=a%25253Fextra%25253D1%25zz&tab=b",
		"expected": "https://wordpress.com/?tab=b"
	},
	{
		"description": "keeps a non-ASCII value verbatim",
		"input": "https://wordpress.com/?query=café",
		"expected": "https://wordpress.com/?query=café"
	},
	{
		"description": "keeps %00 in a non-URL value verbatim",
